# The real Express/MongoDB backend this web app proxies to — same backend
# mobile uses. Include the /api/v1 prefix.
BACKEND_API_URL=https://planamwell-backend.onrender.com/api/v1

# Encrypts the httpOnly session cookie (iron-session). Must be at least 32
# random characters and MUST stay secret — anyone with this value can forge
# a session. Generate one with: openssl rand -base64 32
# Rotating this value invalidates every logged-in session.
SESSION_SECRET=

# WhatsApp Business number for the "Chat on WhatsApp" handoff on the Ask
# AmWell AI page. Not a secret (bundled into client JS) — same number the
# real Meta WhatsApp Business integration sends from (backend's SUPPORT_PHONE
# env var). E.164 format, digits only after the +.
NEXT_PUBLIC_SUPPORT_PHONE=+2349168767784

# The backend's origin (no /api/v1 suffix), for the browser's direct
# Socket.IO connection used for WebRTC call signaling. This is the one
# deliberate exception to "the browser never talks to the backend directly" —
# it carries only a short-lived, narrow-purpose socket token (minted by
# GET /api/socket-token), never the real access/refresh tokens. Everything
# else stays on the BACKEND_API_URL-via-BFF path above.
NEXT_PUBLIC_SOCKET_URL=https://planamwell-backend.onrender.com
